<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that doesn't need Windows: the DSP, the library model, artwork rules, skins, strings.
       Builds and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuVa.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings.json" LogicalName="NuVa.Strings.json" />
  </ItemGroup>
</Project>
